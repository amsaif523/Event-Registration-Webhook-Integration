# Copy to .env for local development.

# Base path for the API. Left empty the app calls same-origin /api/*, which the
# Vite dev proxy forwards to Apache. Only set this if the backend lives elsewhere.
VITE_API_BASE_URL=

# false -> the UI calls the real POST /api/* endpoints (needs the backend running)
# true  -> the UI reads /data/mock.json (design mode, no backend needed)
VITE_USE_MOCK=false
