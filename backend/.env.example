# Copy to .env and fill in. .env is never committed.

APP_ENV=local
APP_DEBUG=true
# Base URL of the site. Used to decide whether cookies get the Secure flag.
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=event_registration
DB_USERNAME=root
DB_PASSWORD=
# Separate database for the test suite. It is dropped and rebuilt by the tests.
DB_TEST_DATABASE=event_registration_test
SEED_ADMIN_PASSWORD=ChangeMe123!!
# --- Auth -------------------------------------------------------------------
# Signing key for access-token JWTs. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Changing it invalidates every access token immediately, which is the intended
# emergency lever.
JWT_SECRET=change_me_to_a_64_char_hex_string
JWT_ISSUER=eventide

# Access tokens are short-lived because they cannot be revoked individually.
ACCESS_TOKEN_TTL=900          # 15 minutes, in seconds
# Refresh tokens are long-lived, stored hashed, rotated on every use, and can
# be revoked.
REFRESH_TOKEN_TTL=2592000     # 30 days, in seconds

# Failed logins per account before it is locked, and how long the lock lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Webhooks ---------------------------------------------------------------
WEBHOOK_SECRET=change_me_to_a_long_random_string
WEBHOOK_TOLERANCE_SECONDS=300

# Exposes POST /api/dev/simulate-webhook. Never true in production.
DEMO_MODE=true
