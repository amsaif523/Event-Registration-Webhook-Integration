{
  "name": "eventide/backend",
  "description": "Event registration and webhook integration API. Plain PHP, no framework.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
