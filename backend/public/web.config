<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS equivalent of .htaccess. Requires the URL Rewrite module; without it the
  rule is ignored and every /api/* request 404s.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Serve existing files directly" stopProcessing="true">
          <match url="^" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Front controller" stopProcessing="true">
          <match url="^" />
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
